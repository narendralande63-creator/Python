# Experiment 5: Stack using Array

SIZE = 5

stack = []
top = -1


# Push
def push(data):
    global top

    if top == SIZE - 1:
        print("Stack Overflow")
    else:
        stack.append(data)
        top = top + 1
        print(data, "pushed into stack")


# Pop
def pop():
    global top

    if top == -1:
        print("Stack Underflow")
    else:
        print(stack[top], "popped from stack")
        stack.pop()
        top = top - 1


# Peek
def peek():
    if top == -1:
        print("Stack is empty")
    else:
        print("Top element:", stack[top])


# Display
def display():
    if top == -1:
        print("Stack is empty")
    else:
        print("Stack elements:")

        for i in range(top, -1, -1):
            print(stack[i])


push(10)
push(20)
push(30)

display()

peek()

pop()

print("After pop:")
display()
